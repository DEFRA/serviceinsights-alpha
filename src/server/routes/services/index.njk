{% extends 'layouts/page.njk' %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/details/macro.njk" import govukDetails %}

{% macro coverageTable(coverage) %}
  <table class="govuk-table app-coverage">
    <tbody class="govuk-table__body">
      {% for f in coverage %}
        <tr class="govuk-table__row">
          <th scope="row" class="govuk-table__header govuk-!-font-weight-regular">{{ f.label }}</th>
          <td class="govuk-table__cell app-coverage__bar-cell">
            <span class="app-coverage__bar"><span class="app-coverage__fill app-coverage__fill--{{ f.bucket }}"></span></span>
          </td>
          <td class="govuk-table__cell govuk-table__cell--numeric">{{ f.pct }}% <span class="govuk-hint govuk-!-display-inline">({{ f.present }}/{{ f.total }})</span></td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endmacro %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl govuk-!-margin-bottom-2">Services</h1>
      <p class="govuk-body-l govuk-!-margin-bottom-2">
        {{ shownCount }} of {{ totalCount }} services{% if filtered %} (filtered){% endif %}
      </p>
      <p class="govuk-body govuk-!-margin-bottom-4">
        {{ incompleteTotal }} of {{ totalCount }} are missing data the management tool will collect.
      </p>

      {{ govukDetails({
        summaryText: "Field coverage across all " + totalCount + " services",
        html: coverageTable(coverage)
      }) }}

      <form method="get" action="/" class="govuk-!-margin-bottom-6">
        <div class="govuk-grid-row">
          <div class="govuk-grid-column-two-thirds">
            {{ govukInput({
              label: { text: "Search", classes: "govuk-label--s" },
              id: "q", name: "q", type: "search", value: q,
              spellcheck: false,
              attributes: { placeholder: "Name or organisation" }
            }) }}
          </div>
        </div>
        <div class="govuk-grid-row">
          <div class="govuk-grid-column-one-third">
            {{ govukSelect({
              label: { text: "Organisation", classes: "govuk-label--s" },
              id: "org", name: "org", items: orgItems
            }) }}
          </div>
          <div class="govuk-grid-column-one-third">
            {{ govukSelect({
              label: { text: "Phase", classes: "govuk-label--s" },
              id: "phase", name: "phase", items: phaseItems
            }) }}
          </div>
          <div class="govuk-grid-column-one-third">
            {{ govukSelect({
              label: { text: "Completeness", classes: "govuk-label--s" },
              id: "complete", name: "complete", items: completeItems
            }) }}
          </div>
        </div>
        <div class="govuk-button-group">
          {{ govukButton({ text: "Filter" }) }}
          {% if filtered %}<a class="govuk-link" href="/">Clear filters</a>{% endif %}
        </div>
      </form>

      {% if rows.length %}
        {{ govukTable({
          head: [
            { text: "Service" },
            { text: "Organisation" },
            { text: "Delivery group" },
            { text: "Phase" },
            { text: "Completeness" }
          ],
          rows: rows
        }) }}
      {% else %}
        <p class="govuk-body">No services match your search.</p>
      {% endif %}
    </div>
  </div>
{% endblock %}
